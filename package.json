{
  "name": "vivilens-ecommerce-v1",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare_tryon_assets.mjs --public && vite --host 0.0.0.0",
    "build": "vite build --emptyOutDir && node scripts/build_social_pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build:pages && wrangler pages deploy dist --project-name vivilens --branch main",
    "test": "node --test",
    "build:brand": "node scripts/build_brand_assets.mjs",
    "seo:sync": "node scripts/sync_seo_catalog.mjs",
    "check:seo": "node scripts/check_seo.mjs",
    "build:pages": "npm run build && node scripts/build_pages.mjs",
    "deploy:legacy": "wrangler deploy --config wrangler.legacy.jsonc",
    "tryon:profiles": "node scripts/build_tryon_profiles.mjs",
    "tryon:assets": "node scripts/prepare_tryon_assets.mjs --public"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.0",
    "@tensorflow-models/face-landmarks-detection": "1.0.6",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.24.0",
    "sharp": "0.35.4",
    "vite": "6.0.5",
    "wrangler": "4.135.0"
  }
}
